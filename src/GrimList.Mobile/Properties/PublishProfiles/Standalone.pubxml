<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Sideload milestone. Pass release keystore properties for public distribution. -->
    <AndroidKeyStore>false</AndroidKeyStore>
    <PublishDir>$(MSBuildProjectDirectory)/../../artifacts/builds/android/$(Version)/</PublishDir>
  </PropertyGroup>
</Project>
