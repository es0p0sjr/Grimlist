<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- ARM64 phones and the existing x64 emulator receive the same standalone APK. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Keep this test package independent of the locally blocked trimming task host. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Local sideload testing uses the existing development signing key. -->
    <AndroidKeyStore>false</AndroidKeyStore>
  </PropertyGroup>
</Project>
