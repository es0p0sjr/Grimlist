<Window x:Class="GrimList.Desktop.PricingRepairWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Repair missing points — GrimList" Width="1120" Height="750" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Repair missing points" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Check unavailable prices and apply recovered prices together. Crucible and battle-only references are skipped. Saved army selections are preserved; recovered units receive updated loadout options." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,14"><Button x:Name="OnlineButton" Content="Find fixes online" Click="FindOnline" Margin="0,0,8,0"/><Button x:Name="CachedButton" Content="Check cached source" Click="CheckCache" Margin="0,0,8,0"/><Button x:Name="LocalButton" Content="Choose source ZIP" Click="ChooseSource" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="Stop" Click="Stop" Visibility="Collapsed"/></WrapPanel>
  <DataGrid Grid.Row="2" x:Name="Results" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
   <DataGridTextColumn Header="Faction" Binding="{Binding Faction}" Width="140"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="190"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="135"/>
   <DataGridTemplateColumn Header="Prices / reason" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Prices}" TextWrapping="Wrap"/><TextBlock Text="{Binding AlliedPrices, StringFormat=Allies: {0}}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3" Margin="0,14"><TextBlock x:Name="Summary" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><TextBlock x:Name="ImpactText" TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="0,6,0,0"/></StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ReportButton" Content="Export report" Click="ExportReport" Margin="0,0,8,0"/><Button Content="Close" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Content="Apply recovered prices" Click="Apply" Style="{StaticResource Primary}" IsEnabled="False"/></StackPanel>
 </Grid>
</Window>
