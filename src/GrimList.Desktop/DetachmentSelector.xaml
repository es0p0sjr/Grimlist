<UserControl x:Class="GrimList.Desktop.DetachmentSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <DataTemplate x:Key="PreviewCard"><Border Background="Black" Padding="14" Margin="0,0,0,10" CornerRadius="4"><StackPanel><DockPanel><TextBlock Text="{Binding Cost}" DockPanel.Dock="Right" Foreground="#F4D58D" FontWeight="Bold" Margin="12,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="GAME SIZE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="GameSizePicker" DisplayMemberPath="Label" SelectedValuePath="Points" SelectionChanged="GameSizeChanged" AutomationProperties.Name="Game size"/><TextBlock x:Name="BudgetText" TextWrapping="Wrap" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock x:Name="BudgetHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="ARMY DISPOSITION" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="DispositionPicker" SelectionChanged="ChooseDisposition" AutomationProperties.Name="Army disposition" Margin="0,0,0,10"/></StackPanel>
   <ItemsControl Grid.Row="1" x:Name="SelectedCards" Margin="0,0,0,12"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#303B32" CornerRadius="3" Padding="8" Margin="0,0,0,4"><DockPanel><Button Content="Remove" DockPanel.Dock="Right" Tag="{Binding}" Click="Remove" Padding="6,3" Margin="8,0,0,0"/><TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Grid.Row="2" Text="AVAILABLE DETACHMENTS" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7"/>
   <ListBox Grid.Row="3" x:Name="OptionsList" SelectedValuePath="Name" SelectionChanged="PreviewChanged" AutomationProperties.Name="Available detachments"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="12,9"><Button DockPanel.Dock="Right" Content="{Binding Action}" IsEnabled="{Binding Enabled}" Tag="{Binding Name}" Click="QuickToggle" Margin="8,0,0,0" Padding="8,4" VerticalAlignment="Center"/><StackPanel><DockPanel><TextBlock Text="{Binding CostLabel}" Foreground="#F4D58D" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  </Grid>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8"><Button x:Name="ToggleButton" Content="Add detachment" Click="Toggle" DockPanel.Dock="Right" Padding="16,8" Margin="15,0,0,0" VerticalAlignment="Top" Background="{DynamicResource Accent}"/><StackPanel><TextBlock x:Name="PreviewName" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewMeta" Foreground="#F4D58D" Margin="0,6,0,0"/></StackPanel></DockPanel>
   <TextBlock Grid.Row="1" x:Name="SelectionHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
   <ScrollViewer x:Name="PreviewScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
    <TextBlock Text="Detachment rule" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="RuleCards" ItemTemplate="{StaticResource PreviewCard}"/>
    <TextBlock Text="Stratagems" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="StratagemCards" ItemTemplate="{StaticResource StratagemCardTemplate}"/>
    <TextBlock Text="Enhancements" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="EnhancementCards" ItemTemplate="{StaticResource PreviewCard}"/>
    <TextBlock x:Name="NoReferences" Text="No reference rules imported for this detachment." Foreground="{StaticResource Muted}" Margin="0,12"/>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
