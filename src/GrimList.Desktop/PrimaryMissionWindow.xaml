<Window x:Class="GrimList.Desktop.PrimaryMissionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Primary mission card" Width="660" Height="700" MinWidth="380" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="MissionName" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="YOUR PRIMARY MISSION" Foreground="#F4D58D" FontSize="12" Margin="0,6,0,0"/><TextBlock x:Name="MatchupText" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="16"><StackPanel>
    <TextBlock x:Name="CardText" Text="Loading mission card…" FontSize="15" TextWrapping="Wrap" LineHeight="25"/>
    <TextBlock x:Name="CardSource" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0"/>
   </StackPanel></Border>
  </ScrollViewer>
  <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="RetryButton" Content="Retry" Click="Retry" Visibility="Collapsed" Margin="0,0,8,0"/><Button Content="Open card source" Click="OpenSource" Margin="0,0,8,0"/><Button x:Name="CloseButton" Content="Close" IsCancel="True" Click="CloseCard" MinWidth="90"/></WrapPanel>
 </Grid>
</Window>
