<UserControl x:Class="GrimList.Desktop.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{StaticResource Ink}" Background="{StaticResource Background}">
 <DockPanel Margin="8">
  <StackPanel DockPanel.Dock="Top" Margin="4,0,0,16"><TextBlock Text="GrimList" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="DatasetText" FontSize="12"/><TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
  <StackPanel x:Name="SearchPanel" Visibility="Collapsed" DockPanel.Dock="Top" Margin="0,0,0,12" HorizontalAlignment="Left"><TextBlock Text="Search saved armies" FontSize="12"/><TextBox x:Name="HomeSearch" Width="350" TextChanged="SearchChanged"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <WrapPanel x:Name="TilePanel">
    <Button x:Name="NewArmyTile" Width="174" Height="112" Content="＋" FontSize="52" Background="#403D75" BorderThickness="0" Margin="0,0,10,10" Click="NewArmy" ToolTip="Create army" AutomationProperties.Name="Create army"/>
    <Button Width="174" Height="112" Content="⌕" FontSize="60" Background="#403D75" BorderThickness="0" Margin="0,0,10,10" Click="SearchArmies" ToolTip="Search saved armies" AutomationProperties.Name="Search saved armies"/>
   </WrapPanel>
   <TextBlock x:Name="EmptyText" Text="Create your first army with +." Foreground="{StaticResource Muted}" Margin="4,12"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</UserControl>
