<Window x:Class="GrimList.Desktop.RuleReferenceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Rule reference" Width="620" Height="540" MinWidth="380" MinHeight="280" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="ReferenceTitle" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="RULE REFERENCE" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="DefinitionCards"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10"><StackPanel>
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,9"/>
    <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" LineHeight="21"/>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <Button Grid.Row="2" x:Name="CloseButton" Content="Close" IsCancel="True" Click="CloseReference" HorizontalAlignment="Right" MinWidth="90" Margin="0,12,0,0"/>
 </Grid>
</Window>
