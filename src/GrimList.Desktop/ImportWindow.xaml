<Window x:Class="GrimList.Desktop.ImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Manage data — GrimList" Width="1000" Height="860" MinWidth="900" MinHeight="760" WindowStartupLocation="CenterOwner">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Manage data" FontSize="25" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><ComboBox x:Name="Provider" Width="155" Margin="0,0,8,0" SelectionChanged="SetProvider"><ComboBoxItem Content="BSData + MFM"/><ComboBoxItem Content="MFM points only"/></ComboBox><ComboBox x:Name="DownloadEdition" Width="125" Margin="0,0,8,0"><ComboBoxItem Content="10th edition"/><ComboBoxItem Content="11th edition"/></ComboBox><ComboBox x:Name="DownloadFaction" Width="180" Margin="0,0,8,0"/><Button x:Name="DownloadButton" Content="↓ Download data" Click="DownloadPoints"/><Button x:Name="RepairButton" Content="Repair missing points" Click="RepairMissingPoints" Margin="8,0,0,0"/><Button x:Name="StopButton" Content="Stop" Click="StopDownload" Visibility="Collapsed" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="Download data → review changes → apply. 11th edition combines BSData datasheets with MFM unit points from the versioned mirror." Foreground="{StaticResource Muted}" Margin="0,8,0,14" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,0,0,14"><ComboBox x:Name="LayerPicker" Width="170" SelectionChanged="InvalidatePreview"><ComboBoxItem Content="Points only"/><ComboBoxItem Content="Datasheets only"/><ComboBoxItem Content="Points + datasheets"/></ComboBox><TextBlock Text="Edition" VerticalAlignment="Center" Margin="14,0,6,0"/><TextBox x:Name="EditionBox" Width="55" ToolTip="Edition number; leave blank if unknown" TextChanged="SourceChanged"/><CheckBox x:Name="CompleteFaction" Content="Complete faction points" Margin="16,0,0,0" VerticalAlignment="Center" Checked="ScopeChanged" Unchecked="ScopeChanged" ToolTip="Clear prices for units absent from the imported factions. Leave unchecked for a small sample or partial update."/></WrapPanel>
   <TextBlock Text="11th-edition BSData updates also check mapped Wahapedia stratagem pages. Any unavailable or incomplete references are flagged for review." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="SOURCE NAME" Style="{StaticResource Caption}"/><TextBox x:Name="SourceName" Text="BSData · All armies"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="VERSION" Style="{StaticResource Caption}"/><TextBox x:Name="VersionBox" Text="Unspecified"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SOURCE DATE · YYYY-MM-DD" Style="{StaticResource Caption}"/><TextBox x:Name="DateBox"/></StackPanel></Grid>
  <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="PUBLIC SOURCE URL (OPTIONAL)" Style="{StaticResource Caption}"/><TextBox x:Name="UrlBox" Text="https://github.com/BSData/wh40k-11e"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="FACTION IF NOT IN DOCUMENT" Style="{StaticResource Caption}"/><ComboBox x:Name="FallbackFaction" SelectionChanged="InvalidatePreview"/></StackPanel></Grid>
  <TabControl Grid.Row="3" x:Name="Tabs" Background="Transparent" BorderBrush="{StaticResource Line}">
   <TabItem Header="  1. Source  "><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><Button x:Name="BrowseButton" Content="Choose local source" Click="Browse" DockPanel.Dock="Left"/><TextBlock x:Name="FileLabel" Text="BSData ZIP / catalogue · GrimList JSON · MFM PDF / text" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Grid.Row="1" x:Name="LoadedSourceText" Visibility="Collapsed" TextWrapping="Wrap" Margin="8"/><TextBox Grid.Row="1" x:Name="RawText" IsUndoEnabled="False" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" TextChanged="SourceChanged"/><TextBlock Grid.Row="2" Text="For BSData, select the matching edition above and choose the repository ZIP to include shared catalogues. Imports categories, points and datasheets." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></Grid></TabItem>
   <TabItem Header="  2. Review units  "><DataGrid x:Name="PreviewGrid" Margin="10"><DataGrid.Columns><DataGridTextColumn Header="Faction" Binding="{Binding Faction}" Width="*" MinWidth="150"/><DataGridTemplateColumn Header="Unit / category" Width="2*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Unit}"/><TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Models" Binding="{Binding Models}" Width="75" MinWidth="75"/><DataGridTextColumn Header="Copy ≥" Binding="{Binding Copy}" Width="75" MinWidth="75"/><DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="75" MinWidth="75"/><DataGridTextColumn Header="Datasheet" Binding="{Binding Profile}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="  3. Changes  "><ListBox x:Name="ChangesList" Margin="14"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="4,7" FontSize="12"/></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
  </TabControl>
  <StackPanel Grid.Row="4" Margin="0,14,0,14"><ProgressBar x:Name="ImportProgress" Height="5" Margin="0,0,0,10" Visibility="Collapsed"/><TextBlock x:Name="Summary" Text="Download data or choose a local source, then review." FontWeight="SemiBold" TextWrapping="Wrap"/><ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0"><TextBlock x:Name="Warnings" TextWrapping="Wrap" FontSize="11" Foreground="#DCB87D"/></ScrollViewer><TextBlock Text="Complete BSData downloads mark superseded detachments obsolete when applied; saved armies are kept for review. Points-only updates do not retire detachments. Previous versions remain saved locally." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="PreviewButton" Content="Preview import" Click="Preview" Margin="0,0,8,0"/><Button x:Name="ApplyButton" Content="Apply update" Style="{StaticResource Primary}" Click="Apply" IsEnabled="False"/></StackPanel>
 </Grid>
</Window>
