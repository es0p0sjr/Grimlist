<Window x:Class="GrimList.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GrimList.Desktop" Style="{StaticResource {x:Type Window}}" Title="GrimList" Width="1440" Height="880" MinWidth="1100" MinHeight="650" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown">
 <Window.Resources>
  <Style x:Key="PointsLimitInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="FontSize" Value="16"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="LimitChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LimitChrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="WeaponKeywordsTemplate">
   <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
   <StackPanel>
   <Border Margin="6,0,6,7" Padding="7,5" Background="#182321" BorderBrush="#52635F" BorderThickness="0,1,0,0" CornerRadius="0,0,3,3">
    <Border.Style>
     <Style TargetType="Border">
      <Style.Triggers>
       <DataTrigger Binding="{Binding Visibility, ElementName=KeywordText}" Value="Collapsed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <local:WeaponKeywords x:Name="KeywordText" Keywords="{Binding Keywords}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"/>
   </Border>
   </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="StatValueTemplate"><StackPanel Width="42" Margin="0,0,8,0"><TextBlock Text="{Binding Key}" FontSize="10" TextAlignment="Center"/><Border Background="Black" CornerRadius="3" Padding="0,4"><TextBlock Text="{Binding Value}" TextAlignment="Center" FontSize="18" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Modified}" Value="True"><Setter Property="Foreground" Value="#F4D58D"/><Setter Property="TextDecorations" Value="Underline"/><Setter Property="ToolTip" Value="Modified by active rules"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></StackPanel></DataTemplate>
  <Style x:Key="AttachmentGroups" TargetType="GroupItem">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
    <Border x:Name="GroupBorder"><StackPanel>
     <TextBlock x:Name="GroupHeading" Text="{Binding Name.Summary}" Visibility="Collapsed" FontSize="11" FontWeight="Bold" Foreground="#E1E5B7" Margin="4,2,4,9" TextWrapping="Wrap"/>
     <ItemsPresenter/>
    </StackPanel></Border>
    <ControlTemplate.Triggers><DataTrigger Binding="{Binding Name.IsAttached}" Value="True">
     <Setter TargetName="GroupBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
     <Setter TargetName="GroupBorder" Property="BorderThickness" Value="2"/>
     <Setter TargetName="GroupBorder" Property="Background" Value="#202821"/>
     <Setter TargetName="GroupBorder" Property="CornerRadius" Value="5"/>
     <Setter TargetName="GroupBorder" Property="Padding" Value="7"/>
     <Setter TargetName="GroupBorder" Property="Margin" Value="0,3,0,12"/>
     <Setter TargetName="GroupHeading" Property="Visibility" Value="Visible"/>
    </DataTrigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="UnitGroups" TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,6"><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="1" Panel.ZIndex="5" VerticalAlignment="Top" x:Name="GlobalTools" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6"><Button Content="BSData ↗" Click="OpenCommunity" Background="Transparent" BorderThickness="0"/><Button x:Name="CheckButton" Content="Update data" Click="CheckUpdates" Background="{DynamicResource Accent}" Margin="6,0" ToolTip="Download BSData and MFM unit points, then review changes before applying."/><Button Content="Manage data" Click="ImportPoints" Background="Transparent" BorderThickness="0"/><Button Content="Report a Bug" Click="ReportBug" Background="Transparent" BorderThickness="0"/><Button Content="Export dataset" Click="ExportDataset" Background="Transparent" BorderThickness="0"/></StackPanel>
  <local:HomeView Grid.Row="1" x:Name="Home"/>
  <local:ArmySetupView Grid.Row="1" x:Name="Setup" Visibility="Collapsed"/>
  <Grid Grid.Row="1" x:Name="BuilderScreen" Visibility="Collapsed" Margin="3">
   <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="NewArmyButton" Content="←" Click="GoHome" Background="Transparent" BorderThickness="0" FontSize="26" ToolTip="Armies"/>
    <Button Grid.Column="1" x:Name="UndoButton" Content="↶" Click="Undo" Background="Transparent" BorderThickness="0" FontSize="25" ToolTip="Undo"/>
    <Button Grid.Column="2" x:Name="RedoButton" Content="↷" Click="Redo" Background="Transparent" BorderThickness="0" FontSize="25" ToolTip="Redo"/>
    <TextBox Grid.Column="3" x:Name="ArmyName" Text="Untitled army" LostFocus="SaveFields" MaxLength="100" ToolTip="Army name" Margin="3,0,5,0"/>
    <Grid Grid.Column="4" Margin="0,0,5,0"><ProgressBar x:Name="PointsBar" Background="#30332B" Foreground="{DynamicResource Accent}" Maximum="2000" BorderThickness="0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="TotalText" FontSize="16"/><TextBlock Text=" points  (" FontSize="16"/><TextBlock x:Name="RemainingText" FontSize="16"/><TextBlock Text=")" FontSize="16"/></StackPanel></Grid>
    <StackPanel Grid.Column="5" Orientation="Horizontal"><Button x:Name="RosterUpdateButton" Content="Update data" Click="CheckUpdates" Padding="10,5" Margin="0,0,6,0" ToolTip="Download BSData and MFM unit points, then review changes before applying."/><Button x:Name="PlayModeButton" Content="Play mode" Click="TogglePlayMode" Background="{DynamicResource Accent}" Padding="12,5" Margin="0,0,6,0"/><Button x:Name="RulesButton" Content="Army rules" Click="ShowRules" Background="Transparent" BorderThickness="0"/></StackPanel>
    <Button Grid.Column="6" x:Name="RosterMenuButton" AutomationProperties.Name="Roster actions" Content="☰" Click="OpenRosterMenu" Background="Transparent" BorderThickness="0" FontSize="24" ToolTip="Roster actions"/>
   </Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="235" MinWidth="180"/><ColumnDefinition x:Name="LibraryDividerColumn" Width="5"/><ColumnDefinition Width="255" MinWidth="190"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="500"/></Grid.ColumnDefinitions>
    <Grid x:Name="LibraryPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><DockPanel><Button Content="×" Click="ClearSearch" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" ToolTip="Clear search" FontSize="21"/><TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="Search unit names or keywords" ToolTip="Search unit names or keywords · Ctrl+K"/></DockPanel><DockPanel Margin="2,5"><TextBlock x:Name="UnitCount" FontSize="11" Foreground="{StaticResource Muted}"/><CheckBox x:Name="FitsOnly" Content="Fits remaining" HorizontalAlignment="Right" Checked="FilterChanged" Unchecked="FilterChanged" FontSize="11"/></DockPanel>
      <WrapPanel Margin="2,3,2,7">
       <CheckBox x:Name="HideLegends" Content="Hide Legends" Checked="FilterChanged" Unchecked="FilterChanged" FontSize="12" Margin="0,0,12,5" ToolTip="Hide units labelled Legends in the unit library."/>
       <CheckBox x:Name="HideCrucible" Content="Hide Crucible" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" FontSize="12" Margin="0,0,0,5" ToolTip="Hide units labelled Crucible in the unit library."/>
      </WrapPanel>
     </StackPanel>
     <Grid Grid.Row="1"><ListBox x:Name="UnitPicker" SelectionChanged="SelectUnit" PreviewMouseLeftButtonUp="LibraryClicked" ScrollViewer.CanContentScroll="False"><ListBox.GroupStyle><GroupStyle ContainerStyle="{StaticResource UnitGroups}"/></ListBox.GroupStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" FontSize="12" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Padding="3,0" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="＋" Tag="{Binding Key}" Click="QuickAddUnit" IsEnabled="{Binding CanAdd}" ToolTipService.ShowOnDisabled="True" Padding="0" FontSize="25" Background="Transparent" BorderThickness="0" ToolTip="{Binding AddHint}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="LibraryEmpty" Margin="10,25"><TextBlock x:Name="LibraryEmptyTitle" Text="No units" FontSize="16"/><TextBlock x:Name="LibraryEmptyBody" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8"/><Button Content="Manage data" Click="ImportPoints"/></StackPanel></Grid>
     <TextBlock Grid.Row="2" x:Name="SourceText" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="3,5"/>
    </Grid>
    <GridSplitter x:Name="LibraryDivider" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Background}"/>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><ListBox x:Name="Roster" ContextMenuOpening="OpenUnitMenu" SelectedValuePath="Id" SelectionChanged="RosterSelected" ScrollViewer.CanContentScroll="False"><ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu><ListBox.GroupStyle><GroupStyle ContainerStyle="{StaticResource UnitGroups}"/><GroupStyle ContainerStyle="{StaticResource AttachmentGroups}"/></ListBox.GroupStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" FontSize="13" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Padding="3,0" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="×" Tag="{Binding Id}" Click="RemoveUnit" Background="Transparent" BorderThickness="0" Padding="0" FontSize="23" ToolTip="Remove unit"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="RosterEmpty" Text="Add units with +." Foreground="{StaticResource Muted}" Margin="10,25" TextWrapping="Wrap"/></Grid>
     <StackPanel Grid.Row="1" Margin="4,8"><StackPanel x:Name="MusterPanel" Margin="0,0,0,8"/><TextBlock Text="WARLORD" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="WarlordPicker" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SelectWarlord" AutomationProperties.Name="Warlord"/><TextBlock x:Name="WarlordHint" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock x:Name="RosterCount" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="EnhancementBudgetText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock x:Name="AlliesSummaryText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock x:Name="ValidationText" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    </Grid>
    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Background}"/>
    <Grid Grid.Column="4">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource Accent}" Padding="12"><StackPanel><TextBlock x:Name="DetailName" Text="SELECT A UNIT" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="PrimaryModelName" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" Visibility="Collapsed"/><ItemsControl x:Name="Stats" ItemTemplate="{StaticResource StatValueTemplate}" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><WrapPanel x:Name="DefensiveStats"><StackPanel x:Name="InvulnerablePanel" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed"><Border Background="Black" CornerRadius="3" Width="42" Padding="0,5"><TextBlock x:Name="InvulnerableValue" TextAlignment="Center" FontSize="18" FontWeight="SemiBold"/></Border><Border Background="{DynamicResource AccentDark}" CornerRadius="0,3,3,0" Padding="10,3" VerticalAlignment="Center"><TextBlock Text="INVULNERABLE SAVE" FontSize="12" FontWeight="Bold"/></Border></StackPanel><Button x:Name="FeelNoPainPanel" Visibility="Collapsed" Click="ShowFeelNoPain" AutomationProperties.Name="Feel No Pain rule" Background="Black" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="FeelNoPainValue" FontSize="18" FontWeight="SemiBold"/></Button></WrapPanel><StackPanel x:Name="ModelsSection" Visibility="Collapsed"><ItemsControl x:Name="ModelCards"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Characteristics}" ItemTemplate="{StaticResource StatValueTemplate}" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><WrapPanel><StackPanel Orientation="Horizontal" Visibility="{Binding InvulnerableVisibility}" Margin="{Binding InvulnerableMargin}"><Border Background="Black" CornerRadius="3" Width="42" Padding="0,5"><TextBlock Text="{Binding InvulnerableSave}" TextAlignment="Center" FontSize="18" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding InvulnerableModified}" Value="True"><Setter Property="Foreground" Value="#F4D58D"/><Setter Property="TextDecorations" Value="Underline"/><Setter Property="ToolTip" Value="Modified by active rules"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><Border Background="{DynamicResource AccentDark}" Padding="10,3" VerticalAlignment="Center"><TextBlock Text="INVULNERABLE SAVE" FontSize="12" FontWeight="Bold"/></Border></StackPanel><Border Background="Black" CornerRadius="3" Padding="10,5" Margin="8,6,0,0" Visibility="{Binding FeelNoPainVisibility}"><TextBlock Text="{Binding FeelNoPain}" FontSize="18" FontWeight="SemiBold"/></Border></WrapPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><TextBlock x:Name="AllyHintText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/><TextBlock x:Name="UnitKeywords" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
     <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition x:Name="LoadoutGap" Width="12"/><ColumnDefinition x:Name="LoadoutColumn" Width="*"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <CheckBox x:Name="TargetAfflicted" Content="Target is Afflicted" Checked="TargetConditionChanged" Unchecked="TargetConditionChanged" Visibility="Collapsed" Margin="8,0,8,10" ToolTip="Preview weapon bonuses that apply against Afflicted targets."/><StackPanel x:Name="AttachmentSummary" Visibility="Collapsed" Margin="0,0,0,8"/><TextBlock x:Name="LoadoutSummary" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="8,0,8,10" Visibility="Collapsed"/><TextBlock x:Name="PlayLoadoutNotice" TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="8,0,8,10" Visibility="Collapsed"/><Border x:Name="MissingDatasheet" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="Datasheet not imported" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="MissingDatasheetText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,10"/><Button x:Name="ImportDatasheetsButton" Content="Import datasheets" Click="ImportDatasheets" HorizontalAlignment="Left"/></StackPanel></Border>

       <TextBlock x:Name="UnitPointsBreakdown" TextWrapping="Wrap" FontSize="12" Foreground="#F4D58D" Margin="8,0,8,12"/>
       <StackPanel x:Name="DatasheetChoices" Margin="8,0,8,12"/>
  <Border x:Name="ErrorBanner" Visibility="Collapsed" Margin="0,0,0,12" Padding="14" Background="#3D1F23" BorderBrush="#EF8585" BorderThickness="1" CornerRadius="6">
   <StackPanel>
    <DockPanel Margin="0,0,0,6"><Button x:Name="DismissErrorButton" DockPanel.Dock="Right" Content="×" Click="DismissError" Background="Transparent" BorderThickness="0" Padding="5,0" FontSize="20" ToolTip="Dismiss error" AutomationProperties.Name="Dismiss error"/><TextBlock Text="ENHANCEMENT / UPGRADE" Foreground="#FFA5A5" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180"><TextBlock x:Name="ErrorMessage" TextWrapping="Wrap" Foreground="#FFF3F3" FontSize="13" LineHeight="19" AutomationProperties.LiveSetting="Assertive"/></ScrollViewer>
   </StackPanel>
  </Border>
       <StackPanel x:Name="EnhancementsSection" Visibility="Collapsed" Margin="0,0,0,12">
        <Border Background="{DynamicResource Accent}" Padding="9,7"><TextBlock Text="ENHANCEMENTS &amp; UPGRADES" FontWeight="Bold"/></Border>
        <StackPanel x:Name="EnhancementEditor" Visibility="Collapsed" Margin="0,8,0,0">
         <TextBlock x:Name="EnhancementEditorHint" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="8,0,8,8"/>
         <ItemsControl x:Name="UnitEnhancementChoices"><ItemsControl.ItemTemplate><DataTemplate>
          <Button Tag="{Binding Selection}" Click="ChooseEnhancement" IsEnabled="{Binding Available}" HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,0,0,6" ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Name}">
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="BorderThickness" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentDark}"/><Setter Property="BorderBrush" Value="#E1E5B7"/></DataTrigger></Style.Triggers></Style></Button.Style>
           <DockPanel><StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Cost}" Foreground="#F4D58D" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Action}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detachment}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel>
          </Button>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel x:Name="SelectedEnhancementSection" Visibility="Collapsed"><Border Background="Black" Padding="12"><StackPanel><TextBlock x:Name="SelectedEnhancementName" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SelectedEnhancementMeta" Foreground="#F4D58D" Margin="0,5,0,8" TextWrapping="Wrap"/><TextBlock x:Name="SelectedEnhancementRule" TextWrapping="Wrap" LineHeight="19"/><TextBlock x:Name="EnhancementWarning" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,7,0,0"/><Button x:Name="RemoveEnhancementButton" Content="Remove enhancement" Click="RemoveEnhancement" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
       </StackPanel>
       <TextBlock Text="Select a weapon for keyword rules" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,8,8"/><StackPanel x:Name="RangedWeaponsSection" Visibility="Collapsed" Margin="0,0,0,10">
       <Border Background="{DynamicResource Accent}" Padding="9,7"><TextBlock Text="RANGED WEAPONS" FontWeight="Bold"/></Border>
       <DataGrid x:Name="RangedWeaponTable" PreviewMouseUp="WeaponProfileTapped" PreviewKeyDown="WeaponProfileKeyDown" Cursor="Hand" ToolTip="Select a weapon to read its keyword rules. Keyboard: Enter or Space." FontSize="12" MinHeight="40" RowDetailsVisibilityMode="Visible" RowDetailsTemplate="{StaticResource WeaponKeywordsTemplate}"><DataGrid.Columns><DataGridTextColumn Header="Weapon" Binding="{Binding Name}" Width="*" MinWidth="120"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4,7"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="50" MinWidth="50"/><DataGridTextColumn Header="A" Binding="{Binding Attacks}" Width="Auto" MinWidth="44"/><DataGridTextColumn Header="BS" Binding="{Binding Skill}" Width="38" MinWidth="38"/><DataGridTextColumn Header="S" Binding="{Binding Strength}" Width="Auto" MinWidth="32"/><DataGridTextColumn Header="AP" Binding="{Binding Ap}" Width="30" MinWidth="30"/><DataGridTextColumn Header="D" Binding="{Binding Damage}" Width="Auto" MinWidth="50"/></DataGrid.Columns></DataGrid>
       </StackPanel>
       <StackPanel x:Name="MeleeWeaponsSection" Visibility="Collapsed">
       <Border Background="{DynamicResource Accent}" Padding="9,7"><TextBlock Text="MELEE WEAPONS" FontWeight="Bold"/></Border>
       <DataGrid x:Name="MeleeWeaponTable" PreviewMouseUp="WeaponProfileTapped" PreviewKeyDown="WeaponProfileKeyDown" Cursor="Hand" ToolTip="Select a weapon to read its keyword rules. Keyboard: Enter or Space." FontSize="12" MinHeight="40" RowDetailsVisibilityMode="Visible" RowDetailsTemplate="{StaticResource WeaponKeywordsTemplate}"><DataGrid.Columns><DataGridTextColumn Header="Weapon" Binding="{Binding Name}" Width="*" MinWidth="120"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4,7"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="50" MinWidth="50"/><DataGridTextColumn Header="A" Binding="{Binding Attacks}" Width="Auto" MinWidth="44"/><DataGridTextColumn Header="WS" Binding="{Binding Skill}" Width="38" MinWidth="38"/><DataGridTextColumn Header="S" Binding="{Binding Strength}" Width="Auto" MinWidth="32"/><DataGridTextColumn Header="AP" Binding="{Binding Ap}" Width="30" MinWidth="30"/><DataGridTextColumn Header="D" Binding="{Binding Damage}" Width="Auto" MinWidth="50"/></DataGrid.Columns></DataGrid>
       </StackPanel>
       <TextBlock x:Name="NoProfiles" Text="No weapon profiles in this points source." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="10"/>

      </StackPanel>
      </ScrollViewer><Grid Grid.Column="2" x:Name="DetailSidebar"><Grid.RowDefinitions><RowDefinition x:Name="AbilitiesRow" Height="*"/><RowDefinition x:Name="SidebarGap" Height="8"/><RowDefinition x:Name="LoadoutEditorRow" Height="1.2*"/></Grid.RowDefinitions><ScrollViewer x:Name="AbilitySidebar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Expander x:Name="AbilitiesSection" Header="ABILITIES &amp; RULES" IsExpanded="True" Margin="0"><ItemsControl x:Name="AbilityCards" ItemTemplate="{StaticResource AbilityCardTemplate}"/></Expander></ScrollViewer><GridSplitter x:Name="SidebarDivider" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource Line}"/><ScrollViewer x:Name="LoadoutEditor" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <Border Background="{DynamicResource Accent}" Padding="9,7"><TextBlock Text="UNIT COMPOSITION AND LOADOUT" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/></Border>
       <StackPanel Margin="6,7,6,4">
        <StackPanel x:Name="LibraryComposition"><ComboBox x:Name="SizePicker" SelectionChanged="PreviewSizeChanged" DisplayMemberPath="Label" Margin="0,0,0,7"/><Button x:Name="AddButton" ToolTipService.ShowOnDisabled="True" Content="＋ Add unit" Click="AddUnit" Background="{DynamicResource Accent}" IsEnabled="False"/></StackPanel>
        <StackPanel x:Name="RosterComposition" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="DecreaseSizeButton" Content="−" Click="StepUnitSize" Tag="-1" Background="{DynamicResource Accent}" Padding="0" FontSize="21" ToolTip="Previous available unit size"/>
         <ComboBox Grid.Column="1" x:Name="EntrySizePicker" DisplayMemberPath="Label" SelectedValuePath="Models" SelectionChanged="ResizeUnit" Margin="5,0"/>
         <Button Grid.Column="2" x:Name="IncreaseSizeButton" Content="＋" Click="StepUnitSize" Tag="1" Background="{DynamicResource Accent}" Padding="0" FontSize="21" ToolTip="Next available unit size"/>
         <Button Grid.Column="3" x:Name="DuplicateEntryButton" ToolTipService.ShowOnDisabled="True" Content="⧉" ToolTip="Duplicate unit" AutomationProperties.Name="Duplicate unit" Click="DuplicateUnit" Margin="6,0,0,0" Padding="8,0" FontSize="20"/>
        </Grid><TextBlock x:Name="DetailModels" Visibility="Collapsed"/></StackPanel>
       </StackPanel>
       <StackPanel x:Name="AttachmentEditor" Visibility="Collapsed" Margin="8,8,8,10"/><TextBlock x:Name="LoadoutHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="8,8,8,10" FontSize="12"/>
       <TextBlock x:Name="LoadoutWarnings" TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="8" FontSize="12"/>
       <StackPanel x:Name="LoadoutCards" Margin="0,4,0,0"/>
       <WrapPanel Margin="4,4,4,10"><Button x:Name="ResetLoadoutButton" Content="Reset to defaults" Click="ResetLoadout" Margin="0,0,6,4"/><Button x:Name="ImportLoadoutButton" Content="Import loadout options" Click="ImportDatasheets" Margin="0,0,0,4"/></WrapPanel>
       <TextBlock x:Name="DetailSource" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="8,12,8,0"/>
      </StackPanel>
     </ScrollViewer></Grid></Grid>
    </Grid>
   </Grid>
  </Grid>
  <Grid Grid.Row="1" x:Name="RulesScreen" Visibility="Collapsed" Margin="3">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Background="{DynamicResource Accent}" MinHeight="52">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="CloseRulesButton" Content="←" Click="CloseRules" Background="Transparent" BorderThickness="0" FontSize="26" Padding="10,2" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" x:Name="FactionText" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,8,8,8" VerticalAlignment="Center"><TextBlock Text="Max points" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="LimitBox" Style="{StaticResource PointsLimitInput}" Text="2000" Width="100" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" LostFocus="SaveFields" MaxLength="7" AutomationProperties.Name="Maximum army points"/></StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="#303B32" Padding="14" Margin="10,12,10,0" CornerRadius="4"><StackPanel>
     <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RulesUndoButton" Content="Undo" Click="Undo" Margin="8,0,0,0"/><Button x:Name="RulesRedoButton" Content="Redo" Click="Redo" Margin="8,0,0,0"/><Button x:Name="SelectDetachmentsButton" Content="Add detachments" Click="SelectDetachments" Background="{DynamicResource Accent}" Margin="14,0,0,0"/></StackPanel><StackPanel><TextBlock x:Name="SelectedDetachmentsText" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetachmentBudgetText" Foreground="#F4D58D" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
     <ItemsControl x:Name="CurrentDetachments" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#1D2321" CornerRadius="4" Padding="10,6" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><TextBlock Text="{Binding Cost}" Foreground="#F4D58D" Margin="10,0" VerticalAlignment="Center"/><Button Content="×" Tag="{Binding Name}" Click="RemoveDetachment" ToolTip="Remove detachment" AutomationProperties.Name="Remove detachment" Padding="6,0" FontSize="19"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <StackPanel x:Name="DetachmentOptionsPanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock Text="Add with one click. Changes save immediately and can be undone." Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
      <ItemsControl x:Name="AvailableDetachments"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="310" Background="Black" Padding="12" Margin="0,0,8,8" CornerRadius="4"><DockPanel><Button DockPanel.Dock="Right" Content="{Binding Action}" IsEnabled="{Binding CanAdd}" Tag="{Binding Name}" Click="AddDetachment" Margin="10,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding Cost}" Foreground="#F4D58D" Margin="0,0,8,0"/><TextBlock Text="{Binding Disposition}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </StackPanel></Border>
    <Border Background="#252D29" Padding="12" Margin="10,8,10,12" CornerRadius="4"><DockPanel><TextBlock Text="Army disposition" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="DispositionPicker" SelectionChanged="ChooseDisposition" MinWidth="195" HorizontalAlignment="Left" AutomationProperties.Name="Army disposition"/><TextBlock x:Name="DispositionHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0"/></DockPanel></Border>
    <Border Background="#252D29" Padding="12" Margin="10,0,10,12" CornerRadius="4"><StackPanel>
     <TextBlock x:Name="PrimaryMissionsTitle" Text="Primary missions" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="PrimaryMissionsHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/>
     <Grid x:Name="PrimaryMatchupHeader" Margin="8,0,8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="OPPONENT DISPOSITION" FontSize="11" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="YOUR PRIMARY" FontSize="11" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="OPPONENT PRIMARY" FontSize="11" TextWrapping="Wrap"/>
     </Grid>
     <ItemsControl x:Name="PrimaryMatchups" AutomationProperties.Name="Disposition primary matchups"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#161C19" Padding="8" Margin="0,0,0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding OpponentDisposition}" TextWrapping="Wrap" Margin="0,0,10,0"/>
       <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{Binding YourPrimary}" FontWeight="SemiBold" Foreground="#F4D58D" TextWrapping="Wrap"/><Button Content="View primary card" Tag="{Binding}" Click="ShowPrimaryMission" HorizontalAlignment="Left" Margin="0,5,0,0" FontSize="12" AutomationProperties.Name="{Binding YourPrimary, StringFormat=View primary card: {0}}"/></StackPanel>
       <TextBlock Grid.Column="2" Text="{Binding OpponentPrimary}" TextWrapping="Wrap"/>
      </Grid></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button x:Name="PrimaryMissionsSource" Click="OpenPrimarySource" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="11" AutomationProperties.Name="Primary missions official source"/>
    </StackPanel></Border>
    <TextBlock Text="Army Rules" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="ArmyRuleCards" ItemTemplate="{StaticResource RuleCardTemplate}"/><TextBlock x:Name="NoArmyRules" Text="No army rules imported." Foreground="{StaticResource Muted}" Margin="10"/>
    <TextBlock Text="Detachments" Style="{StaticResource SectionTitle}"/><Expander x:Name="DetachmentExpander" IsExpanded="True" Margin="10,6"><StackPanel><TextBlock x:Name="DetachmentText" Margin="10"/><ItemsControl x:Name="DetachmentCards" ItemTemplate="{StaticResource RuleCardTemplate}"/></StackPanel></Expander>
    <TextBlock Text="Enhancements" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="EnhancementCards" ItemTemplate="{StaticResource RuleCardTemplate}"/><TextBlock x:Name="NoEnhancements" Text="No enhancements imported." Foreground="{StaticResource Muted}" Margin="10"/>
    <TextBlock Text="Army &amp; Detachment Stratagems" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="StratagemCards" ItemTemplate="{StaticResource StratagemCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="360"/></Style></ItemsControl.ItemContainerStyle></ItemsControl><TextBlock x:Name="NoStratagems" Text="No stratagems imported." Foreground="{StaticResource Muted}" Margin="10"/>
    <Expander x:Name="PreviousStratagems" Header="Previous references — not verified for current rules" Margin="10" IsExpanded="False"><StackPanel><TextBlock Text="These stored cards may belong to an earlier codex. Use Update data to check for current replacements." TextWrapping="Wrap" Margin="0,8"/><ItemsControl x:Name="PreviousStratagemCards" ItemTemplate="{StaticResource StratagemCardTemplate}"/></StackPanel></Expander>
    <TextBlock Text="Core Stratagems &#183; All armies" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="CoreStratagemHint" Foreground="{StaticResource Muted}" Margin="10" TextWrapping="Wrap"/>
    <ItemsControl x:Name="CoreStratagemCards" ItemTemplate="{StaticResource StratagemCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="360"/></Style></ItemsControl.ItemContainerStyle></ItemsControl>
    <ItemsControl x:Name="OtherReferenceCards" ItemTemplate="{StaticResource RuleCardTemplate}"/>

    <TextBlock Text="Choose enhancements on eligible characters in the roster. Their points are included in the army total; detachment DP is tracked separately." Foreground="{StaticResource Muted}" FontSize="11" Margin="10,20"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" Margin="8,0"><TextBlock x:Name="StatusText" Text="Ready" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="Ctrl+K Search   Ctrl+N New   Ctrl+S Save" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>

 </Grid>
</Window>
